<?xml version="1.0" encoding="utf-8"?>
<!-- res/xml/network_security_config.xml
     AndroidManifest.xml 의 <application android:networkSecurityConfig="@xml/network_security_config"> 로 연결한다.
     문법: https://developer.android.com/privacy-and-security/security-config -->
<network-security-config>

    <!-- 1) 기본: 평문 금지, 시스템 CA만 믿는다(사용자가 설치한 CA는 믿지 않는다. API 24+ 기본값과 같다) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 2) 우리 API: 사설 루트만 믿고, 중간 CA 공개키를 고정한다 -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.lab.example</domain>
        <trust-anchors>
            <certificates src="@raw/lab_root" />
        </trust-anchors>
        <!-- expiration 이 지나면 피닝을 끈다: 업데이트를 못 받은 옛 앱이 영원히 끊기지 않게 -->
        <pin-set expiration="2027-04-30">
            <!-- 지금 쓰는 중간 CA(Lab Example Issuing CA I1)의 SPKI -->
            <pin digest="SHA-256">@PIN_INTER@</pin>
            <!-- 예비 키: 아직 인증서가 없는, 금고에 둔 다음 중간 CA 키. 교체할 때 앱 업데이트 없이 넘어간다 -->
            <pin digest="SHA-256">@PIN_BACKUP@</pin>
        </pin-set>
    </domain-config>

    <!-- 3) 디버그 빌드(android:debuggable=true)에서만 더하는 신뢰. 릴리스 빌드는 이 부분을 무시한다.
         여기 CA로 서명된 사슬에는 피닝도 적용되지 않는다(공식 문서). 개발 서버용 CA만 넣는다.
         dev_ca.pem 은 이 예제에 없다. 팀의 개발용 사설 CA(수업 5-1·5-2 step-ca 등)를 넣는다 -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="@raw/dev_ca" />
        </trust-anchors>
    </debug-overrides>

</network-security-config>
